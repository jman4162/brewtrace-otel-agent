# Where to send OTLP telemetry (Jaeger and otel-lgtm both listen here)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Service name shown in Jaeger/Grafana
OTEL_SERVICE_NAME=brewtrace

# Optional: opt in to the newer experimental GenAI semantic-convention names
# (gen_ai.provider.name, gen_ai.usage.input_tokens) instead of the legacy ones
# (gen_ai.system, gen_ai.usage.prompt_tokens) that strands 1.46 emits by default.
# OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
